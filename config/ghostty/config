# Ghostty config — docs: https://ghostty.org/docs/config
# Show options: ghostty +show-config --default --docs

font-family = "Victor Mono"

# Window
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
mouse-hide-while-typing = true
background-opacity = 0.85
background-blur = true

# Quick terminal (drop-down from top). This combo isn't meant to be pressed by
# hand: Hammerspoon sends it on a double-tap of Control (config/hammerspoon).
keybind = global:ctrl+alt+super+shift+backquote=toggle_quick_terminal
