{
  "permissions": {
    "allow": [
      "Bash(brew install:*)",
      "Bash(curl:*)",
      "Bash(gh api:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Read(//tmp/**)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:blog.optional.page)",
      "WebFetch(domain:dysonlogos.blog)",
      "WebFetch(domain:forum.obsidian.md)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gnomestew.com)",
      "WebFetch(domain:help.obsidian.md)",
      "WebFetch(domain:historyrise.com)",
      "WebFetch(domain:obsidian.md)",
      "WebFetch(domain:obsidian.rocks)",
      "WebFetch(domain:plugins.javalent.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:shieldmarch.com)",
      "WebFetch(domain:www.moritzjung.dev)",
      "WebFetch(domain:www.roleplayingtips.com)",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "auto",
  "editorMode": "normal",
  "preferredNotifChannel": "notifications_disabled",
  "autoScrollEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
